# Copie este arquivo para .env e preencha com os seus valores.
# NUNCA faça commit do .env (ele já está no .gitignore).

# Supabase: Project Settings > Database > Connection string
# Usada pela aplicação (pode ser a do pooler, porta 6543)
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Usada pelas migrations (conexão direta, porta 5432)
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# JWT — gere um segredo forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-grande-e-aleatorio"
JWT_EXPIRES_IN="1h"

# Primeiro administrador criado por "npx prisma db seed"
ADMIN_EMAIL="admin@panvel.com"
ADMIN_SENHA="troque-esta-senha"

PORT=3000
